# ============================================================================
# Weiyedai LLM runtime configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and edit for YOUR machine. These
# settings control the optional Qwen2.5 explanation layer only — the
# deterministic DSCR / pricing math never depends on them.
#
#   cp .env.example .env
#
# You never need to edit Python code to switch device or use a remote GPU.
# `.env` is git-ignored, so your local settings stay private.
# ============================================================================

# Which backend runs the model:
#   local  -> load the model on THIS machine (CUDA or CPU)
#   remote -> call a remote OpenAI-compatible GPU endpoint (nothing local)
WEIYEDAI_LLM_BACKEND=local

# ----------------------------------------------------------------------------
# LOCAL backend — your own CUDA / CPU setup
# ----------------------------------------------------------------------------
# Device to run on:
#   auto    -> let accelerate place the model (default; good for 1 GPU)
#   cuda    -> first visible CUDA GPU
#   cuda:0  -> pin to GPU index 0  (use cuda:1, cuda:2, ... for others)
#   cpu     -> no GPU, CPU only (slow, but works anywhere)
WEIYEDAI_LLM_DEVICE=auto

# Use 4-bit QLoRA quantization (needs bitsandbytes + CUDA). Set false to load
# in full precision if you have enough VRAM. Ignored when DEVICE=cpu.
WEIYEDAI_LLM_LOAD_IN_4BIT=true

# Compute dtype: float16 (default), bfloat16 (newer GPUs), or float32 (CPU).
WEIYEDAI_LLM_TORCH_DTYPE=float16

# Optionally restrict which physical GPUs are visible, e.g. "0" or "0,1".
# Leave blank to use whatever CUDA sees. Applied before torch is imported.
WEIYEDAI_LLM_CUDA_VISIBLE_DEVICES=

# ----------------------------------------------------------------------------
# REMOTE backend — run the model on someone else's / a cloud GPU
# ----------------------------------------------------------------------------
# Point this at any OpenAI-compatible chat endpoint and set BACKEND=remote:
#   vLLM       http://<host>:8000/v1
#   Ollama     http://<host>:11434/v1
#   LM Studio  http://<host>:1234/v1
#   Together / Groq / OpenRouter / OpenAI ...
# Required only when WEIYEDAI_LLM_BACKEND=remote.
WEIYEDAI_LLM_REMOTE_BASE_URL=
# Bearer token for the endpoint (leave blank for local servers that need none).
WEIYEDAI_LLM_REMOTE_API_KEY=
# The model name the remote server serves.
WEIYEDAI_LLM_REMOTE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Request timeout in seconds.
WEIYEDAI_LLM_REMOTE_TIMEOUT=60

# ----------------------------------------------------------------------------
# Model identity (rarely changed)
# ----------------------------------------------------------------------------
# WEIYEDAI_LLM_BASE_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
# WEIYEDAI_LLM_ADAPTER_REPO_ID=Bintangdanis/qwen2.5-weiyedai-copilot-adapter
